# =============================================================================
# DataForge Scraper — Production Environment Template
# =============================================================================
# Copy this file to .env and fill in your values.
#   cp .env.production.example .env
#
# REQUIRED: DATAFORGE_ENV, DATAFORGE_IMAGE_TAG, DATAFORGE_API_KEY_FILE,
#           DATAFORGE_OPERATOR_API_KEY_FILE, DATAFORGE_ADMIN_API_KEY_FILE,
#           DATAFORGE_SESSION_SECRET_FILE, DATAFORGE_CORS_ORIGINS,
#           DATAFORGE_DB_PASSWORD, DATAFORGE_STORAGE_BACKEND,
#           DATAFORGE_DATABASE_URL, DATAFORGE_WORKER_QUEUE,
#           DATAFORGE_QUEUE_BACKEND, DATAFORGE_PG_DRIVER,
#           DATAFORGE_METRICS_TOKEN,
#           GRAFANA_USER, GRAFANA_PASSWORD,
#           DATAFORGE_GROQ_API_KEY or GROQ_API_KEY
# =============================================================================

# ─── Production Mode ────────────────────────────────────────────────────
DATAFORGE_ENV=production

# Immutable application image tag used by docker-compose.prod.yml.
# Set this to the release version or CI commit SHA being deployed; never a mutable tag.
DATAFORGE_IMAGE_TAG=CHANGE_ME_RELEASE_VERSION_OR_GIT_SHA

# ─── Public ingress ─────────────────────────────────────────────────────
# Host ports published by the nginx service. Keep these separate from the
# development app's generic PORT variable.
HTTP_PORT=80
HTTPS_PORT=443

# Directory containing nginx TLS files named fullchain.pem and privkey.pem.
# The production compose file mounts this at /etc/nginx/ssl.
DATAFORGE_NGINX_SSL_DIR=./.secrets/nginx

# Webroot for ACME http-01 challenge files served by nginx over port 80.
DATAFORGE_CERTBOT_WEBROOT=./.secrets/certbot/www

# ─── Security (REQUIRED in production) ──────────────────────────────────
# API/session secrets are read from Docker-secret-compatible files so the
# plaintext values do not appear in `docker inspect` environment output.
# Generate each file with: python3 -c "import secrets; print(secrets.token_hex(32))"
DATAFORGE_API_KEY_FILE=./.secrets/dataforge_api_key

# Operator API key — can create/cancel jobs and mutate selectors/strategies.
DATAFORGE_OPERATOR_API_KEY_FILE=./.secrets/dataforge_operator_api_key

# Admin API key — full system access (scheduler, refactor, diagnostics export).
DATAFORGE_ADMIN_API_KEY_FILE=./.secrets/dataforge_admin_api_key

# Session secret for cookie signing. Required in production.
DATAFORGE_SESSION_SECRET_FILE=./.secrets/dataforge_session_secret

# Billing webhook verification secret — required if billing webhooks are exposed.
DATAFORGE_BILLING_WEBHOOK_SECRET=CHANGE_ME_GENERATE_STRONG_BILLING_WEBHOOK_SECRET

# CORS origins — JSON array of allowed origins. Must NOT contain "*" in production.
# Example: ["https://dataforge.example.com"]
DATAFORGE_CORS_ORIGINS=["https://yourdomain.com"]

# Content Security Policy is enforced (not report-only) in production.
# DATAFORGE_CSP_REPORT_ONLY=false

# ─── Storage Backend ────────────────────────────────────────────────────
# Explicit Postgres mode. Production requires "postgres".
DATAFORGE_STORAGE_BACKEND=postgres

# Postgres driver selection. The production image installs only psycopg3
# (psycopg2 is intentionally excluded to keep the image small and to
# force the new driver path). This MUST be set to "psycopg3" in production
# so that get_job_repository() and the Postgres worker queue resolve to
# the psycopg3 implementations. The startup validator rejects any other
# value when DATAFORGE_ENV=production.
DATAFORGE_PG_DRIVER=psycopg3

# Postgres pool sizing
DATAFORGE_PG_MIN_CONN=2
DATAFORGE_PG_MAX_CONN=20

# Postgres password — source of truth for docker-compose.prod.yml.
# This is used by both the dataforge service and the postgres container.
# Must be the same value in both places.
DATAFORGE_DB_PASSWORD=CHANGE_ME_GENERATE_STRONG_DB_PASSWORD

# Postgres connection string (used when STORAGE_BACKEND=postgres).
# The password in this URL is overridden by DATAFORGE_DB_PASSWORD in Compose.
DATAFORGE_DATABASE_URL=postgresql://dataforge:CHANGE_ME_GENERATE_STRONG_DB_PASSWORD@postgres:5432/dataforge

# ─── Worker Queue ───────────────────────────────────────────────────────
# Enqueues jobs to background worker instead of running inline.
DATAFORGE_WORKER_QUEUE=true
# Queue backend — Production requires "postgres"
DATAFORGE_QUEUE_BACKEND=postgres

# Workflow persistence backend — "postgres" for production.
DATAFORGE_WORKFLOW_BACKEND=postgres

# ─── LLM Credentials (required for AI structuring) ──────────────────────
# Set either DATAFORGE_GROQ_API_KEY or GROQ_API_KEY. The production
# environment checker fails closed when both are empty while public
# fallbacks are disabled.
DATAFORGE_GROQ_API_KEY=CHANGE_ME_GENERATE_STRONG_GROQ_API_KEY
# GROQ_API_KEY=CHANGE_ME_GENERATE_STRONG_GROQ_API_KEY
# Unauthenticated public LLM fallbacks are disabled by default and must
# remain false in production unless explicitly risk-reviewed.
DATAFORGE_LLM_ENABLE_PUBLIC_FALLBACKS=false

# ─── Browser / Playwright (production overrides) ─────────────────────────
# Override browser defaults for production workloads.
# DATAFORGE_PLAYWRIGHT_TIMEOUT=45000
# DATAFORGE_BROWSER_MAX_CONTEXTS=10
# DATAFORGE_BROWSER_MAX_PROCESSES=2
# DATAFORGE_BROWSER_IDLE_TIMEOUT=300
# DATAFORGE_BROWSER_MAX_RSS_MEMORY_MB=1024
# DATAFORGE_BROWSER_SECURITY_HARDENING=true
# DATAFORGE_PLAYWRIGHT_STEALTH=true

# ─── Anti-Bot / Captcha (production overrides) ───────────────────────────
# Enable captcha solver in production if needed.
# DATAFORGE_CAPTCHA_SOLVER_ENABLED=false
# DATAFORGE_CAPTCHA_PROVIDER=2captcha
# DATAFORGE_CAPTCHA_API_KEY=CHANGE_ME_CAPTCHA_API_KEY
# DATAFORGE_CF_HARVESTER_ENABLED=false

# ─── Proxy (production overrides) ────────────────────────────────────────
# DATAFORGE_PROXY_ROTATION_ENABLED=false
# DATAFORGE_PROXY_PROVIDER_TYPE=static

# ─── Rate Limiting (production overrides) ────────────────────────────────
# Database-backed rate limiting auto-promotes to True in production.
# DATAFORGE_RATE_LIMIT_DB_BACKED=true
# DATAFORGE_RATE_LIMIT_GLOBAL=600/minute
# DATAFORGE_RATE_LIMIT_PER_IP=100/minute

# ─── Notifications (optional) ───────────────────────────────────────────
# Telegram notifications are optional but production templates must
# document the same knobs as the development template so operators do
# not miss alert/test notification setup.
DATAFORGE_TELEGRAM_ENABLED=false
# DATAFORGE_TELEGRAM_BOT_TOKEN=
# DATAFORGE_TELEGRAM_CHAT_ID=
# DATAFORGE_TELEGRAM_API_BASE=https://api.telegram.org
DATAFORGE_TELEGRAM_NOTIFY_ON_TEST_START=false
DATAFORGE_TELEGRAM_NOTIFY_ON_TEST_END=false
DATAFORGE_TELEGRAM_NOTIFY_ON_TEST_FAILURE=true
DATAFORGE_TELEGRAM_NOTIFY_ON_CRITICAL_ERROR=true

# SMTP email notifications (optional)
# DATAFORGE_SMTP_HOST=
# DATAFORGE_SMTP_PORT=587
# DATAFORGE_SMTP_USER=
# DATAFORGE_SMTP_PASS=
# DATAFORGE_SMTP_FROM=
# DATAFORGE_SMTP_USE_SSL=false

# Alertmanager Slack delivery is configured through the slack_webhook
# Docker secret. When Slack delivery is enabled, smoke tests can also
# verify that the bot can read the intended channel via conversations.info.
# SLACK_BOT_TOKEN=
# ALERTMANAGER_SLACK_CHANNEL_ID=

# ─── Monitoring & Observability ─────────────────────────────────────────
# Prometheus scrape token for the internal /metrics endpoint.
DATAFORGE_METRICS_TOKEN=CHANGE_ME_GENERATE_STRONG_METRICS_TOKEN

GRAFANA_USER=admin
# Grafana admin panel password — REQUIRED in production.
# Must be strong and unique (cannot be admin, password, grafana, or change-me).
GRAFANA_PASSWORD=CHANGE_ME_GENERATE_STRONG_GRAFANA_PASSWORD

# ─── TL S Probe Target ──────────────────────────────────────────────────
# Target URL for Prometheus blackbox TLS certificate expiry probe.
# DATAFORGE_TLS_PROBE_TARGET=https://localhost:443

# ─── Semantic State Persistence ─────────────────────────────────────────
# Path for semantic world state persistence file.
# Must point to a writable volume when containers use read_only: true.
DATAFORGE_SEMANTIC_STATE_PATH=/app/backend/data/semantic_state.json

# Base directory for state files. Must point to a writable volume.
DATAFORGE_STATE_DIR=/app/backend/data/w

# Selector memory and domain intelligence paths
# DATAFORGE_SELECTOR_MEMORY_PATH=/app/backend/data/w/selector_memory.json
# DATAFORGE_DOMAIN_INTELLIGENCE_PATH=/app/backend/data/w/domain_intelligence.json

# Audit log directory. Must be writable when containers use read_only: true.
DATAFORGE_AUDIT_LOG_DIR=/app/backend/data/logs

# ─── Node Identity ──────────────────────────────────────────────────────
# Node and shard identifiers for multi-node deployments.
DATAFORGE_NODE_ID=node-1
DATAFORGE_SHARD_ID=shard-1

# ─── Research / Experimental Routes (MUST be false in production) ───────
# The research shell is opt-in via DATAFORGE_ENABLE_EXPERIMENTAL_ROUTES.
# In production this MUST be set to false so that:
#   - research modules are NOT imported at startup
#   - /api/system/* research endpoints return 404
#   - no research-side-effect paths are reachable
#
# Setting this to true will cause the app to log a WARNING at
# construction. The default is false. See backend/app/research/__init__.py
# for the canonical list of research modules.
DATAFORGE_ENABLE_EXPERIMENTAL_ROUTES=false

# ─── Controlled Smoke Test Mode (ONLY for staging/local smoke testing) ──
# Bypasses public SSRF validations for allowed internal Docker hosts (like 'nginx')
# NEVER enable this in a real public production environment!
# DATAFORGE_SMOKE_TEST_MODE=false
# DATAFORGE_ALLOWED_INTERNAL_HOSTS=nginx

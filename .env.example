# =============================================================================
# DataForge Scraper — Environment Configuration
# =============================================================================
# Copy this file to .env and edit for your environment.
#
#   cp .env.example .env
#
# All DATAFORGE_* settings can be overridden at runtime via environment variables.
# =============================================================================

# ─── LLM Provider (Required for AI structuring and schema suggestion) ───────
# Get a free API key from https://console.groq.com
# Supports both DATAFORGE_-prefixed and legacy unprefixed variants.
# The prefixed form takes precedence.
DATAFORGE_GROQ_API_KEY=
GROQ_API_KEY=

# Groq model selection (8B gives 14.4K req/day vs 70B at 1K req/day on free tier)
DATAFORGE_GROQ_DEFAULT_MODEL=llama-3.1-8b-instant
DATAFORGE_GROQ_FALLBACK_MODEL=llama-3.3-70b-versatile

# ─── Server ────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DATAFORGE_ENV=development

# ─── Storage Backend ─────────────────────────────────────────────────────
# Options: sqlite (default), postgres
DATAFORGE_STORAGE_BACKEND=sqlite

# PostgreSQL connection URL (required when STORAGE_BACKEND=postgres)
# DATAFORGE_DATABASE_URL=postgresql://user:${DATAFORGE_DB_PASSWORD}@localhost:5432/dataforge

# Local production-stack override support:
# docker-compose.override.local.yml refuses to start unless these are set
# by the caller, so no test database/Grafana/Slack credentials are
# committed into the override file.
# DATAFORGE_DB_PASSWORD=
# GRAFANA_PASSWORD=
# ALERTMANAGER_SLACK_WEBHOOK_URL=

# Postgres driver: psycopg2 (default) or psycopg3 (required in production).
# Production images ship only psycopg3; psycopg2 is intentionally excluded.
# DATAFORGE_PG_DRIVER=psycopg3

# Postgres pool sizing
DATAFORGE_PG_MIN_CONN=1
DATAFORGE_PG_MAX_CONN=10
# DATAFORGE_DB_CONNECT_TIMEOUT=10

# ─── Worker Queue ───────────────────────────────────────────────────────
# Options: memory (default), postgres
# DATAFORGE_QUEUE_BACKEND=memory
# DATAFORGE_WORKER_QUEUE=false

# Production requires postgres queue backend for cross-process coordination.
# DATAFORGE_WORKER_QUEUE_DYNAMIC=true

# ─── Browser / Playwright ──────────────────────────────────────────────────
DATAFORGE_PLAYWRIGHT_TIMEOUT=45000
DATAFORGE_PAGE_SETTLE_DELAY=2.0
DATAFORGE_PAGE_FALLBACK_EXTRA_WAIT=5.0
DATAFORGE_PROFILE_MAX_WAIT=30

# ─── HTTP Fetching ─────────────────────────────────────────────────────────
DATAFORGE_REQUEST_TIMEOUT=20
DATAFORGE_MAX_RETRIES=2

# ─── Extraction ────────────────────────────────────────────────────────────
DATAFORGE_MAX_RECORDS_PER_SOURCE=25
DATAFORGE_LLM_TIMEOUT=30
DATAFORGE_LLM_MAX_ATTEMPTS=2
DATAFORGE_LLM_BACKOFF_SECONDS=2
DATAFORGE_LLM_ENABLE_PUBLIC_FALLBACKS=false
DATAFORGE_AI_STRUCTURING_CHUNK_SIZE=5
DATAFORGE_AI_CLEAN_TARGET_RECORDS=5
DATAFORGE_AI_STRUCTURING_MAX_CONSECUTIVE_MODEL_FAILURES=5

# ─── Job Runner ────────────────────────────────────────────────────────────
DATAFORGE_PER_URL_TIMEOUT_SECONDS=120
DATAFORGE_MAX_JOB_RUNTIME_SECONDS=1800
DATAFORGE_AI_STRUCTURING_TIMEOUT_SECONDS=240
DATAFORGE_INSIGHT_TIMEOUT_SECONDS=25
DATAFORGE_MAX_DISCOVERY_URLS=20
DATAFORGE_MAX_JOB_HISTORY=300
DATAFORGE_MAX_RECYCLE_BIN_HISTORY=300

# ─── State File ────────────────────────────────────────────────────────────
# DATAFORGE_STATE_FILE_PATH=./backend/data/jobs_state.json
DATAFORGE_SEMANTIC_STATE_PATH=./backend/data/semantic_state.json

# ─── Data Paths ──────────────────────────────────────────────────────────
# DATAFORGE_JOB_STORE_PATH=./backend/data/jobs.json
# DATAFORGE_AUTH_PROFILES_FILE=./backend/data/auth_profiles.json
# DATAFORGE_BILLING_SUBSCRIPTIONS_FILE=./backend/data/billing_subscriptions.json
# DATAFORGE_DENYLIST_DB_PATH=./backend/data/denylist.json
# DATAFORGE_WORKFLOW_RUNS_FILE=./backend/data/workflow_runs.json

# ─── Geocoding ────────────────────────────────────────────────────────────
# Location words for geocode cache key generation
# DATAFORGE_LOCATION_WORDS=city,town,village,district,region,state,country
# DATAFORGE_LOCATION_FILE=./backend/data/locations.json

# ─── Notifications (Telegram) ────────────────────────────────────────────
# TELEGRAM_TOKEN=
# TELEGRAM_TO=
# TELEGRAM_ENABLED=false

# ─── Research / Experimental Routes (GATE) ──────────────────────────────────
# The research shell (semantic world state, topology, federation, gossip,
# motif, energy, instability, strategy evolution, chaos, replay, intent,
# acquisition, etc.) is opt-in. When this flag is false (the default):
#   - research modules are NOT imported at startup
#   - /api/system/* research endpoints are NOT mounted (return 404)
#   - app startup is faster and the import graph is research-free
#
# Set to true ONLY for development environments that need to exercise
# the research subsystems. Enabling this in production logs a WARNING
# at app construction.
#
# The single source of truth for which modules are classified as
# research is backend/app/research/__init__.py.
DATAFORGE_ENABLE_EXPERIMENTAL_ROUTES=false

# ─── Discovery ─────────────────────────────────────────────────────────────
DATAFORGE_BLOCKED_DISCOVERY_DOMAINS=quickfinds.org

# ─── API Security (REQUIRED in production) ──────────────────────────────────
# Generate unique keys for each role:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
#
# Basic API key — required for all API access.
DATAFORGE_API_KEY=

# Operator API key — can create/cancel jobs and mutate selectors/strategies.
# Must be different from DATAFORGE_API_KEY for RBAC to function.
DATAFORGE_OPERATOR_API_KEY=

# Admin API key — full system access (scheduler, diagnostics, export).
# Must be different from the above two for RBAC to function.
DATAFORGE_ADMIN_API_KEY=

# Session secret for cookie signing (REQUIRED in production).
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
DATAFORGE_SESSION_SECRET=

# Allow insecure dev auth bypass (NEVER set to true in production).
# When true, the dev-auth endpoint accepts any non-empty key without
# checking the API key store. Only for local development.
DATAFORGE_ALLOW_INSECURE_DEV_AUTH=false

# Encryption keys for sensitive data at rest (auth profiles, etc.).
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# DATAFORGE_ENCRYPTION_KEY=
# DATAFORGE_ENCRYPTION_KEY_V1=
# DATAFORGE_ENCRYPTION_KEY_V2=
# DATAFORGE_ACTIVE_ENCRYPTION_KEY_VERSION=1

# ─── Content Security Policy ────────────────────────────────────────────
# When true, CSP violations are logged but not enforced (report-only mode).
DATAFORGE_CSP_REPORT_ONLY=true

# ─── Trusted Proxies ─────────────────────────────────────────────────────
# Comma-separated list of trusted reverse-proxy IPs for rate-limit
# origin extraction. Empty = trust no proxies (direct connections only).
# DATAFORGE_TRUSTED_PROXIES=

# ─── Smoke Test Mode ────────────────────────────────────────────────────
# When true, the app starts in a lightweight mode for Docker healthchecks
# and CI smoke tests. Background workers and scheduled tasks are skipped.
DATAFORGE_SMOKE_TEST_MODE=false

# ─── Worker Heartbeat (for multi-worker bare-metal deployments) ───────────
# Worker identity override. By default, the worker_id is derived from the
# hostname (container ID in Docker). For bare-metal multi-worker deployments
# where multiple workers share the same hostname, set a unique ID per worker
# so the healthcheck can distinguish them.
DATAFORGE_WORKER_HEARTBEAT_ID=

# Heartbeat time-to-live in seconds. If no heartbeat is received within this
# window, the worker is considered dead. The default is 60 seconds (aligned
# with the WorkerHeartbeatStale alert's 2m ``for`` duration, which triggers
# after approximately 2 missed beats).
DATAFORGE_WORKER_HEARTBEAT_TTL=60

# ─── Rate Limiting ─────────────────────────────────────────────────────────
# Aggregate global rate limit across all clients for /api/* endpoints.
# Format: N/second, N/minute, or N/hour. Empty = disabled.
DATAFORGE_RATE_LIMIT_GLOBAL=600/minute

# Per-IP fair-sharing cap. Each client IP gets its own counter.
# This is a separate tier from the aggregate global limit — a request
# must pass BOTH tiers to proceed.
DATAFORGE_RATE_LIMIT_PER_IP=100/minute

# Enable per-IP tracking. When True (default), each IP is independently
# rate-limited. When False, only the aggregate global limit applies.
DATAFORGE_RATE_LIMIT_PER_IP_ENABLED=true

# Database-backed rate limiting for multi-process environments.
# Auto-promotes to True in production/staging. When True, counters use
# a shared rate_limits table instead of in-memory storage.
DATAFORGE_RATE_LIMIT_DB_BACKED=false

# ─── PayPal Billing (Subscriptions provider) ──────────────────────────────
# In production, set PAYPAL_CLIENT_ID / PAYPAL_CLIENT_SECRET and
# PAYPAL_ENVIRONMENT=live. In dev/test, leaving these unset returns
# stub checkout responses and free-tier subscription lookups.

# PayPal Dashboard — create an app at https://developer.paypal.com/dashboard/applications
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=

# "sandbox" for testing, "live" for production traffic.
# PAYPAL_ENVIRONMENT=sandbox

# REST API base URL. Defaults to the sandbox URL when unset.
# Override only when PayPal proxies through a different host.
# PAYPAL_API_URL=https://api-m.sandbox.paypal.com

# PayPal Plan IDs created in the PayPal Dashboard (one per internal tier).
# The webhook normalizer maps these back to PlanTierId via env-var lookup.
# PAYPAL_PLAN_ID_STARTER=P-XXXXXXXXXXXXXXXXXXXXX
# PAYPAL_PLAN_ID_PRO=P-XXXXXXXXXXXXXXXXXXXXX
# PAYPAL_PLAN_ID_ENTERPRISE=P-XXXXXXXXXXXXXXXXXXXXX

# Optional shared HMAC secret for webhook verification (alternative to
# PayPal cert-based /v1/notifications/verify). Set in dev/CI to bypass
# cert verification. The settings.BILLING_WEBHOOK_SECRET also works.
# PAYPAL_WEBHOOK_SECRET=
# BILLING_WEBHOOK_SECRET=

# ─── Production Docker Compose Validation Placeholders ──────────────────────
# Required for running config validation on docker-compose.prod.yml locally.
# These MUST be replaced before deploying; the production env-check script
# rejects any value matching the placeholder prefix (e.g. "REPLACE-ME-*").
DATAFORGE_DB_PASSWORD=REPLACE-ME-db-password
DATAFORGE_METRICS_TOKEN=REPLACE-ME-metrics-token
GRAFANA_PASSWORD=REPLACE-ME-grafana-password

# Groq LLM API (primary AI provider)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant

# Runtime limits
DATAFORGE_MAX_DISCOVERY_URLS=20
DATAFORGE_PER_URL_TIMEOUT_SECONDS=120
DATAFORGE_MAX_JOB_RUNTIME_SECONDS=1800
DATAFORGE_AI_STRUCTURING_TIMEOUT_SECONDS=240
DATAFORGE_INSIGHT_TIMEOUT_SECONDS=25
DATAFORGE_MAX_JOB_HISTORY=300
DATAFORGE_MAX_RECYCLE_BIN_HISTORY=300
DATAFORGE_MAX_RECORDS_PER_SOURCE=25
DATAFORGE_AI_STRUCTURING_MAX_CONSECUTIVE_MODEL_FAILURES=5

# Blocked discovery domains (comma-separated)
DATAFORGE_BLOCKED_DISCOVERY_DOMAINS=quickfinds.org

# State file path (default: backend/data/jobs_state.json)
# DATAFORGE_STATE_FILE=backend/data/jobs_state.json

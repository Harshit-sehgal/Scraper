# =============================================================================
# DataForge Scraper — Environment Configuration Template
# =============================================================================

# ─── API Keys ─────────────────────────────────────────────────────────────
# Primary AI provider (Groq)
GROQ_API_KEY=your_groq_api_key_here
# Optional fallback models
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_FALLBACK_MODEL=llama-3.1-8b-instant

# ─── API Security ─────────────────────────────────────────────────────────
# If set, all /api/* endpoints require X-API-Key header.
# DATAFORGE_API_KEY=your_secure_api_key

# ─── Scraper Governance ───────────────────────────────────────────────────
# DATAFORGE_CRAWL_DEFAULT_DELAY_SECONDS=1.0
# DATAFORGE_CRAWL_PER_DOMAIN_CONCURRENCY=2
# DATAFORGE_CRAWL_RESPECT_ROBOTS=True

# ─── Browser / Playwright ─────────────────────────────────────────────────
# DATAFORGE_PLAYWRIGHT_TIMEOUT=45000
# DATAFORGE_PAGE_SETTLE_DELAY=2.0
# DATAFORGE_DOM_STABILIZATION_INTERVAL=200

# ─── LLM Provider Timeouts ─────────────────────────────────────────────
# DATAFORGE_LLM_TIMEOUT=45
# DATAFORGE_LLM_TEMPERATURE=0.1

# ─── Observability ────────────────────────────────────────────────────────
# DATAFORGE_TELEMETRY_RECORD_EXTRACTION=True

# ─── Rate Limiting ─────────────────────────────────────────────────────────
# Aggregate global cap across all clients. Format: N/second, N/minute, N/hour.
# DATAFORGE_RATE_LIMIT_GLOBAL=600/minute
# Per-IP fair-sharing cap (separate tier from aggregate global).
# DATAFORGE_RATE_LIMIT_PER_IP=100/minute
# Enable per-IP tracking (default: true).
# DATAFORGE_RATE_LIMIT_PER_IP_ENABLED=true
# Use database-backed counters for multi-process deployments.
# DATAFORGE_RATE_LIMIT_DB_BACKED=false

# ─── Telegram Notifications ────────────────────────────────────────────────
# Enable Telegram bot notifications for test runs and critical events.
# Get bot token from @BotFather: https://t.me/BotFather
# DATAFORGE_TELEGRAM_BOT_TOKEN=your_bot_token_here
# Get chat ID from @userinfobot or similar: https://t.me/userinfobot
# DATAFORGE_TELEGRAM_CHAT_ID=your_chat_id_here
# Enable/disable Telegram notifications (default: false)
# DATAFORGE_TELEGRAM_ENABLED=false
# Notify when test suite starts (default: true)
# DATAFORGE_TELEGRAM_NOTIFY_ON_TEST_START=true
# Notify when test suite ends with pass/fail summary (default: true)
# DATAFORGE_TELEGRAM_NOTIFY_ON_TEST_END=true
# Notify on individual test failures (default: true)
# DATAFORGE_TELEGRAM_NOTIFY_ON_TEST_FAILURE=true
# Notify on critical application errors (default: true)
# DATAFORGE_TELEGRAM_NOTIFY_ON_CRITICAL_ERROR=true
# Optional: override the Telegram Bot API base URL. Useful for local Bot API
# servers (https://github.com/tdlib/telegram-bot-api) running on a custom
# port. The default is the public api.telegram.org endpoint.
# DATAFORGE_TELEGRAM_API_BASE=https://api.telegram.org

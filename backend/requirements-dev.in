pytest-timeout>=2.3.0
testcontainers[postgres]>=4.0.0,<5.0.0

# ─── Optional Postgres driver (legacy) ──────────────────────────────────────
# The legacy ``PostgresJobRepository`` (psycopg2 driver) is still
# supported. Production images do NOT include ``psycopg2-binary``; it
# is a dev-only optional dependency for operators who still need the
# psycopg2 backend. The recommended path is psycopg 3 (in
# ``requirements.in``), opted into via ``DATAFORGE_PG_DRIVER=psycopg3``.
psycopg2-binary>=2.9.0,<3.0.0


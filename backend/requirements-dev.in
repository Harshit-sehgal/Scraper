# =============================================================================
# DataForge Scraper — Development Dependency Intent
# =============================================================================
# Extends the production stack with test, lint, type-check, and security
# tooling. NEVER install this in a production image.
#
# Lock it with:
#
#   pip-compile --generate-hashes --output-file=requirements-dev.lock.txt \
#               --extra=dev requirements.in
#
# Install in CI with:
#
#   pip install --no-cache-dir -r requirements-dev.lock.txt
# =============================================================================

-r requirements.in


---
# Bandit configuration (YAML format).
#
# This file is discovered automatically by ``bandit`` when run from the
# backend/ directory.  The root ``pyproject.toml`` also carries a
# ``[tool.bandit]`` section, but bandit does not auto-detect that block
# when invoked from a sub-directory.
#
# B101 (assert_used) is skipped: the root pyproject already skips it for
# the whole project.  New asserts must still be paired with runtime
# guards (try/except or ``if x is None:``) so they survive ``python -O``.

skips: ["B101"]

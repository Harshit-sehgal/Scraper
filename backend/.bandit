[bandit]
# B101 (assert_used): the root pyproject.toml already skips this for the
# whole project, but bandit does not auto-detect [tool.bandit] from a
# parent pyproject.toml.  We mirror the skip here so per-folder
# ``bandit -r app/`` matches the CI posture.  New asserts must still be
# paired with runtime guards (try/except or ``if x is None:``) for
# ``python -O`` parity.
skips = B101
